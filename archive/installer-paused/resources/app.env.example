# RPM Assure production configuration
# Location (installed): C:\ProgramData\RPM Resources\RPM Assure\config\app.env
# The Windows service loads this file before starting the app.

RPM_ASSURE_DATA_MODE=auto
RPM_ASSURE_SQL_SERVER=your-sql-host,14333
RPM_ASSURE_SQL_DATABASE=RPMAssure_App
RPM_ASSURE_SQL_USER=Rpm_collect
RPM_ASSURE_SQL_PASSWORD=
RPM_ASSURE_SQL_TRUST_CERT=true

VITE_AUTH_ENABLED=true
BETTER_AUTH_URL=https://assure.rpmresources.co.za
BETTER_AUTH_TRUSTED_ORIGINS=https://assure.rpmresources.co.za
# Generated by wizard if empty:
# BETTER_AUTH_SECRET=

PORT=8081
NITRO_PORT=8081
HOST=0.0.0.0
