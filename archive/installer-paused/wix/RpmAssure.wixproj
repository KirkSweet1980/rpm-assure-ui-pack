<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>RPMAssure-$(Version)</OutputName>
    <ProductVersion Condition="'$(Version)' == ''">1.0.0</ProductVersion>
    <Version>$(ProductVersion)</Version>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>ProductVersion=$(Version)</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Package.wxs" />
    <Compile Include="Service.wxs" />
    <Compile Include="Shortcuts.wxs" />
    <Compile Include="Registry.wxs" />
  </ItemGroup>
  <!-- Harvested payload fragments are included when present -->
  <ItemGroup Condition="Exists('Payload.wxs')">
    <Compile Include="Payload.wxs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
