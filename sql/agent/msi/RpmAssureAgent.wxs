<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="RPM Assure Edge Agent"
      Language="1033"
      Version="2.9.0"
      Manufacturer="RPM Resources"
      UpgradeCode="B8E91C2A-4D17-4F3E-9A6B-7C2E1F0D8A44"
      InstallerVersion="500"
      Scope="perMachine"
      Compressed="yes">
    <SummaryInformation Description="HTTPS agent for RPM Assure. No Git. No public SQL." />
    <MajorUpgrade DowngradeErrorMessage="A newer agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="CUSTOMERCODE" Secure="yes" />
    <Property Id="ASSUREURL" Value="https://assure.rpmresources.co.za" Secure="yes" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="ROOTDRIVE" Value="C:\" />
    <Launch Condition="Installed OR CUSTOMERCODE"
            Message="Pass CUSTOMERCODE (example msiexec /i rpm-assure-agent.msi CUSTOMERCODE=AHIC)" />
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLROOT" Name="RPM-Assure">
        <Directory Id="AGENTDIR" Name="Agent">
          <Component Id="BootstrapExe" Guid="C3A11B44-8E20-4D55-9F01-A1B2C3D4E5F6" Bitness="always64">
            <File Id="BootstrapFile" Source="RpmAssure-Bootstrap.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="RPM Assure Edge" Level="1">
      <ComponentRef Id="BootstrapExe" />
    </Feature>
    <CustomAction Id="SetRunBootstrap" Property="RunBootstrap" Value="-CustomerCode [CUSTOMERCODE] -Url [ASSUREURL]" />
    <CustomAction Id="RunBootstrap" FileRef="BootstrapFile" Execute="deferred" Impersonate="no" Return="check" />
    <InstallExecuteSequence>
      <Custom Action="SetRunBootstrap" After="InstallFiles" Condition="NOT Installed" />
      <Custom Action="RunBootstrap" After="SetRunBootstrap" Condition="NOT Installed" />
    </InstallExecuteSequence>
  </Package>
</Wix>
